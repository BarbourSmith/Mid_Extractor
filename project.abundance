            {
              "atomType": "Readme",
              "x": 0.7795,
              "y": 0.2788,
              "uniqueID": "id-1155",
              "name": "README",
              "ioValues": [
                {
                  "name": "value",
                  "ioValue": "__GEOMETRY_INPUT__"
                }
              ],
              "readMeText": "Readme text here",
              "global": true
            },
            {
              "atomType": "Extrude",
              "x": 0.38,
              "y": 0.2896,
              "uniqueID": "id-1156",
              "ioValues": [
                {
                  "name": "geometry",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
